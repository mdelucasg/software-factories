# PostgreSQL (shared by Hatchet and Phoenix)
POSTGRES_PASSWORD=change-me-postgres-password

# Hatchet Orchestrator
HATCHET_IMAGE_TAG=latest
HATCHET_TENANT_ID=707d0855-80ab-4e1f-a156-f1c4546cbf52
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=hatchet-lite:7077
HATCHET_CLIENT_TLS_STRATEGY=none
HATCHET_WORKER_SLOTS=4

# Webhook Gateway
WEBHOOK_PORT=3000
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Optional GitHub App credentials (used by factory-worker in Ticket #29+)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Egress Allowlist Proxy (Ticket #30)
EGRESS_PROXY_PORT=3128
EGRESS_HEALTH_PORT=3129
EGRESS_ALLOWLIST_DOMAINS=api.anthropic.com,registry.npmjs.org
EGRESS_ALLOWED_PORTS=80,443
