{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "start:gateway": "node dist/webhook/main.js",
    "start:worker": "node dist/orchestrator/worker-main.js",
    "smoke:skeleton": "bash scripts/smoke-skeleton.sh"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.47.4",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
